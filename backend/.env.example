# ─────────────────────────────────────────────
# AI Council — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Select any OpenAI-compatible provider below:

# ── Groq (Recommended — Free & Fast) ──
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# ── OpenAI ──
# LLM_API_KEY=sk-proj-your_openai_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── Google Gemini ──
# LLM_API_KEY=AIzaSy_your_gemini_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# ── Together AI ──
# LLM_API_KEY=your_together_key_here
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── Ollama (Local LLM — Free, No Key Required) ──
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2


